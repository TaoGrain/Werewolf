# 应用与数据库
APP_NAME=多 Agent 狼人杀
DATABASE_URL=sqlite:///./backend/werewolf.db

# 后端与前端服务
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
FRONTEND_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# LLM 通用配置
LLM_PROVIDER=fake
LLM_MODEL=MiniMax-M3
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
LLM_PROVIDER_CONCURRENCY_LIMIT=4
LLM_PROVIDER_MAX_RETRIES=2
LLM_GATEWAY_MAX_TOTAL_ATTEMPTS=9
LLM_HISTORY_MAX_MESSAGES=12
LLM_HISTORY_MAX_CHARACTERS=20000

LLM_PHASE_TIMEOUT_SECONDS=120
LLM_PHASE_OUTPUT_TOKEN_BUDGET=1000000
LLM_SPEECH_TEMPERATURE=0.55
LLM_VOTE_TEMPERATURE=0.35
# MiniMax
MINIMAX_MODEL=MiniMax-M3
MINIMAX_API_URL=https://api.minimax.io/v1/text/chatcompletion_v2
MINIMAX_API_KEY=
MINIMAX_API_KEY_FILE=minimax-apikey.txt

# DeepSeek
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=deepseek-apikey.txt

# OpenAI 兼容 Provider；留空时复用 MiniMax 地址
OPENAI_COMPATIBLE_API_URL=
OPENAI_COMPATIBLE_API_KEY=

# Playwright
PLAYWRIGHT_HOST=127.0.0.1
PLAYWRIGHT_PORT=3000

# MiniMax 真实对局脚本
MINIMAX_RUN_DB=backend/minimax-full-game.db
MINIMAX_RUN_MAX_PHASE_RETRIES=3
MINIMAX_RUN_MAX_STEPS=60
MINIMAX_PROVIDER_MAX_RETRIES=2
